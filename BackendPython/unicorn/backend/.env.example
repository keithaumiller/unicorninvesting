"""
Environment configuration for the Unicorn Investing Platform
Copy this file to .env and update with your actual values
"""

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=unicorn_admin
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=unicorn_analytics

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# External API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
NEWS_API_KEY=your_news_api_key_here

# LEAN Configuration
LEAN_PATH=/workspaces/unicorninvesting/BackendPython/Lean
LEAN_DATA_PATH=/workspaces/unicorninvesting/BackendPython/Lean/Data
LEAN_ALGORITHM_PATH=/workspaces/unicorninvesting/BackendPython/unicorn/algorithms

# Machine Learning Configuration
MODEL_PATH=/workspaces/unicorninvesting/BackendPython/unicorn/models
FEATURE_STORE_PATH=/workspaces/unicorninvesting/BackendPython/unicorn/data
TRAINING_DATA_PATH=/workspaces/unicorninvesting/BackendPython/unicorn/data/training
