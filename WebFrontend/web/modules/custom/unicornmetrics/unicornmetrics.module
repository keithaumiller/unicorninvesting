<?php

/**
 * @file
 * Contains unicornmetrics.module.
 *
 * Provides LEAN framework portfolio and algorithm management functionality
 * with comprehensive metrics display.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Menu\MenuTreeParameters;

/**
 * Implements hook_help().
 */
function unicornmetrics_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.unicornmetrics':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Unicorn Metrics module provides a comprehensive dashboard for managing LEAN algorithmic trading framework portfolios and analyzing performance metrics.') . '</p>';
      $output .= '<h3>' . t('Features') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Multi-portfolio management with switching capabilities') . '</li>';
      $output .= '<li>' . t('Real-time portfolio performance metrics') . '</li>';
      $output .= '<li>' . t('LEAN framework integration for algorithmic trading') . '</li>';
      $output .= '<li>' . t('Holdings analysis and position tracking') . '</li>';
      $output .= '<li>' . t('Risk management and performance analytics') . '</li>';
      $output .= '</ul>';
      $output .= '<h3>' . t('Usage') . '</h3>';
      $output .= '<p>' . t('Navigate to Administration » Metrics to access the dashboard. Users with the "access unicorn metrics" permission can view portfolio data and performance metrics.') . '</p>';
      return $output;

    case 'unicornmetrics.dashboard':
      return '<p>' . t('This dashboard provides comprehensive portfolio management and metrics for LEAN algorithmic trading strategies.') . '</p>';
  }
}

/**
 * Implements hook_theme().
 */
function unicornmetrics_theme() {
  return [
    'unicornmetrics_dashboard' => [
      'variables' => [
        'portfolio_data' => NULL,
        'metrics' => NULL,
        'portfolio_selector' => NULL,
      ],
      'template' => 'unicornmetrics-dashboard',
    ],
    'unicornmetrics_portfolio_selector' => [
      'variables' => [
        'portfolios' => NULL,
        'current_portfolio' => NULL,
        'stats' => NULL,
      ],
      'template' => 'unicornmetrics-portfolio-selector',
    ],
  ];
}

/**
 * Implements hook_menu_links_discovered_alter().
 */
function unicornmetrics_menu_links_discovered_alter(&$links) {
  // Ensure our menu items have proper weights and parents
  if (isset($links['unicornmetrics.admin_dashboard'])) {
    $links['unicornmetrics.admin_dashboard']['weight'] = -10;
  }
}

/**
 * Implements hook_preprocess_menu().
 */
function unicornmetrics_preprocess_menu(&$variables) {
  // Add custom classes to unicornmetrics menu items
  if (isset($variables['menu_name']) && $variables['menu_name'] == 'admin') {
    foreach ($variables['items'] as &$item) {
      if (strpos($item['url']->getRouteName(), 'unicornmetrics.') === 0) {
        $item['attributes']->addClass('unicorn-menu-item');
      }
    }
  }
}

/**
 * Implements hook_preprocess_breadcrumb().
 */
function unicornmetrics_preprocess_breadcrumb(&$variables) {
  $route_match = \Drupal::routeMatch();
  $route_name = $route_match->getRouteName();
  
  // Add custom breadcrumbs for unicornmetrics pages
  if (strpos($route_name, 'unicornmetrics.') === 0) {
    $breadcrumb = $variables['breadcrumb'];
    
    // Add Trading Platform to breadcrumb for all unicornmetrics pages
    $breadcrumb[] = [
      'text' => t('Trading Platform'),
      'url' => \Drupal\Core\Url::fromRoute('unicornmetrics.dashboard'),
    ];
    
    // Add specific breadcrumb items based on route
    switch ($route_name) {
      case 'unicornmetrics.lean_portfolio':
      case 'unicornmetrics.lean_holdings':
      case 'unicornmetrics.lean_performance':
        $breadcrumb[] = [
          'text' => t('Portfolio Management'),
          'url' => \Drupal\Core\Url::fromRoute('unicornmetrics.lean_portfolio'),
        ];
        break;
        
      case 'unicornmetrics.lean_algorithms':
      case 'unicornmetrics.lean_algorithm_performance':
      case 'unicornmetrics.lean_backtest_results':
        $breadcrumb[] = [
          'text' => t('Algorithm Management'),
          'url' => \Drupal\Core\Url::fromRoute('unicornmetrics.lean_algorithms'),
        ];
        break;
        
      case 'unicornmetrics.lean_simulations':
      case 'unicornmetrics.lean_simulation_holdings':
      case 'unicornmetrics.lean_simulation_performance':
      case 'unicornmetrics.lean_simulation_algorithms':
      case 'unicornmetrics.lean_simulation_backtest':
        $breadcrumb[] = [
          'text' => t('Simulation Management'),
          'url' => \Drupal\Core\Url::fromRoute('unicornmetrics.lean_simulations'),
        ];
        break;
    }
    
        $variables['breadcrumb'] = $breadcrumb;
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function unicornmetrics_page_attachments_alter(array &$attachments) {
  $current_route = \Drupal::routeMatch()->getRouteName();
  
  // Attach menu styling to all admin pages and unicornmetrics pages
  if (strpos($current_route, 'system.admin') === 0 || 
      strpos($current_route, 'unicornmetrics.') === 0) {
    $attachments['#attached']['library'][] = 'unicornmetrics/menu-styling';
  }
}

/**
 * Implements hook_toolbar_alter().
 */
function unicornmetrics_toolbar_alter(&$items) {
  // Add quick access to trading dashboard in toolbar
  if (\Drupal::currentUser()->hasPermission('access unicorn metrics')) {
    $items['unicorn_dashboard'] = [
      '#type' => 'toolbar_item',
      'tab' => [
        '#type' => 'link',
        '#title' => t('🦄 Trading'),
        '#url' => \Drupal\Core\Url::fromRoute('unicornmetrics.dashboard'),
        '#attributes' => [
          'class' => ['toolbar-icon', 'toolbar-icon-unicorn-trading'],
          'title' => t('Access Trading Dashboard'),
        ],
      ],
      '#weight' => -15,
    ];
  }
}
