{
  "name": "unicornmetrics-frontend-tests",
  "version": "1.0.0",
  "description": "JavaScript testing framework for UnicornMetrics frontend",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "cypress run",
    "test:integration:open": "cypress open",
    "test:accessibility": "pa11y-ci --sitemap http://localhost/sitemap.xml",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/user-event": "^14.5.0",
    "cypress": "^13.6.0",
    "cypress-axe": "^1.5.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "pa11y-ci": "^3.0.1",
    "axe-core": "^4.8.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/js/test-setup.js"],
    "testMatch": [
      "<rootDir>/js/unit/**/*.test.js",
      "<rootDir>/js/integration/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/cypress/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "cypress": {
    "baseUrl": "http://localhost",
    "supportFile": "js/e2e/support/index.js",
    "specPattern": "js/e2e/**/*.cy.js",
    "video": true,
    "screenshotOnRunFailure": true
  }
}