# Virtual environment should not be committed
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Node modules
node_modules/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Log files
logs/
*.log

# Temporary files
tmp/
temp/

# Drupal cache and generated files
WebFrontend/web/sites/default/files/css/
WebFrontend/web/sites/default/files/js/
WebFrontend/web/sites/default/files/php/twig/
WebFrontend/web/sites/default/files/config_*/
WebFrontend/web/sites/default/files/styles/
WebFrontend/web/sites/default/files/translations/
WebFrontend/web/sites/default/files/backup_migrate/

# Drupal private files and uploads (but allow structure)
WebFrontend/web/sites/default/files/*
!WebFrontend/web/sites/default/files/.gitkeep
!WebFrontend/web/sites/default/files/README.txt

# Drupal settings files with sensitive information
WebFrontend/web/sites/*/settings.local.php
WebFrontend/web/sites/*/services.local.yml

# Status reports and temporary outputs
**/status_report_*.json
**/status_report_*.txt

# Temporary scripts (created during development)
scripts/check_port_forwarding.sh
scripts/test_port_80.sh

# Large data files - exclude from version control
# Raw data files (can be regenerated via connectors)
BackendPython/unicorn/1_data_sources/1_raw/data/*
!BackendPython/unicorn/1_data_sources/1_raw/data/README.md
# Processed bronze layer data files (large ML datasets)
BackendPython/unicorn/1_data_sources/2_bronze/*/processed_data/*
!BackendPython/unicorn/1_data_sources/2_bronze/*/README.md
# Any large CSV or binary data files
*.csv.gz
*.parquet
*.feather
